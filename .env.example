# Copier ce fichier en .env.local et renseigner l'endpoint du formulaire de contact.
# Formspree : créer un formulaire sur https://formspree.io, puis coller l'URL fournie.
# Sans cette variable, le bouton "Envoyer" ouvre le client mail du visiteur (mailto).
VITE_CONTACT_ENDPOINT=https://formspree.io/f/votre_id
